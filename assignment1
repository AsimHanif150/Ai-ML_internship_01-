        "# Your discovery here — extending Discovery B by content_type\n",
        "\n",
        "# Reuse the same filter as Discovery B: only pages with meaningful impressions\n",
        "visible = df[df[\"impressions_90d\"] >= 100]\n",
        "\n",
        "# Average CTR per content_type, within each position tier\n",
        "ctr_by_type_and_pos = (\n",
        "    visible.groupby([\"position_tier\", \"content_type\"])[\"ctr\"]\n",
        "    .mean()\n",
        "    .unstack()\n",
        "    .round(4)\n",
        ")\n",
        "print(ctr_by_type_and_pos.to_string())\n",
        "\n",
        "# For each position tier, which content_type has the lowest CTR?\n",
        "worst_by_tier = ctr_by_type_and_pos.idxmin(axis=1)\n",
        "print(\"\\nWorst-performing content_type per position tier:\")\n",
